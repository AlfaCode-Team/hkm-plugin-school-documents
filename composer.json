{
    "name": "alfacode-team/hkm-plugin-school-documents",
    "description": "School, student, teacher and staff documents with numbering counters and an access log.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolDocuments\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolDocuments\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
